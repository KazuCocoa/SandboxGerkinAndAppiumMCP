{
  "name": "sandbox-gerkin-and-appium-mcp",
  "version": "0.1.0",
  "description": "Prototype Gherkin executor that drives appium-mcp without language bindings",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gherkin-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:e2e:android": "RUN_ANDROID_SMOKE=1 vitest run test/e2e/android.smoke.spec.ts"
  },
  "dependencies": {
    "@cucumber/gherkin": "^32.1.0",
    "@cucumber/messages": "^29.0.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
